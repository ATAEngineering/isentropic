//--------------------     Load Modules    --------------------
loadModule: isentropic
{
//-------------------- Boundary Conditions --------------------
boundary_conditions: <
    inlet = isentropicInflow(p0=1 atm, h0=3.1e6 J/kg),
    outlet = supersonicOutflow(),
    symmetry = symmetry(),
    wall = impermeable()
>

//--------------------  Initial Conditions --------------------
initialConditions: <p=1atm, T=2900K, M=2>
gridCoordinates: axisymmetric


//--------------------    Physics Models   --------------------
chemistry_model: air_5s17r
thermodynamic_model: adaptive
transport_model: none
diffusion_model: none
turbulence_model: none

inviscidFlux: default
limiter: venkatakrishnan
Minf: 1


//-------------------- Time Incrementation --------------------
time_integration: steady_state
newton_iter: 1
fluidLinearSolver: sgs
gauss_seidel_iter: 5
urelax: 0.2
dtmax: 1e-3
stop_iter: 200


//--------------------    Output Control   --------------------
probe: <probe1=[0,0,0]>
probe_freq: 10

print_freq: 200
plot_freq: 10000
plot_modulo: 0
restart_freq: 10000
restart_modulo: 0


}
